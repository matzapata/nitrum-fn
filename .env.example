# Copy to `.env` (gitignored). Load it yourself — scripts do not source this file:
#
#   set -a && source .env && set +a
#
# After `terraform apply` recreates the ALB/NLB, unset stale URL/PCR0 values
# here — destroyed LB hostnames NXDOMAIN.

# ── CLI ──
# Optional override. Default is quiet `cargo run -q --bin nitrum-fn` plus
# RUST_LOG=warn,cli=info (override with NITRUM_FN_E2E_RUST_LOG).
# NITRUM_FN_BIN=cargo run -q --manifest-path /absolute/path/to/nitrum-fn/Cargo.toml --bin nitrum-fn
# NITRUM_FN_E2E_RUST_LOG=warn,cli=info

# ── Scaffold (`nitrum-fn new`) ──
# Parent directory for `nitrum-fn new <NAME>` (creates <PARENT>/<NAME>/).
# Default is <repo>/target/nitrum-fn-e2e-workspace (excluded from the cargo workspace).
# If you override to another path under this repo, add it to workspace.exclude in Cargo.toml.
# NITRUM_FN_E2E_PARENT_DIR=/absolute/path/to/nitrum-fn/target/nitrum-fn-e2e-workspace
# NITRUM_FN_E2E_INIT_NAME=hello-world

# ── Staging (cloud.sh / examples) ──
# Optional: skip terraform lookup.
# NITRUM_FN_API_URL=http://nitrum-fn-api-xxxx.us-east-1.elb.amazonaws.com
# NITRUM_FN_INVOKE_URL=https://nitrum-fn-nlb-xxxx.elb.us-east-1.amazonaws.com
# NITRUM_FN_PCR0=<pcr0 hex from terraform output pcr0>
# NITRUM_FN_E2E_TF_DIR=/absolute/path/to/nitrum-fn/infra/envs/staging
# ENCLAVE_TLS_INSECURE=1
# NITRUM_FN_E2E_API_TIMEOUT=90
# NITRUM_FN_E2E_INVOKE_TIMEOUT=600
# NITRUM_FN_E2E_POLL_SECONDS=5

# ── local.sh ──
# NITRUM_FN_E2E_API_PORT=18090
# NITRUM_FN_E2E_HOST_PORT=18091
# NITRUM_FN_E2E_DATA=/absolute/path/to/nitrum-fn/.data/e2e

# ── Oracle / Foundry ──
# Required for `./examples/oracle/e2e.sh` and forge scripts.
PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ORACLE_ADDRESS=0x
# Optional aliases if NITRUM_FN_* above are unset (e2e.sh copies these over):
# API_URL=
# INVOKE_URL=
# PCR0=
# sha256 of oracle.wasm (0x-prefixed). e2e.sh overwrites this from `describe`.
CONTENT_HASH=0x
# PCR0_HASH=0x
# NITRUM_ORACLE_SKIP_CACHE_CERTS=1
# NITRUM_ORACLE_GAS_LIMIT=16000000

# Deploy.s.sol
# MAX_AGE_SECONDS=3600
# CERT_OWNER=0x
# CERT_REVOKER=0x
# EXISTING_VALIDATOR=0x

# UpdatePrices.s.sol — e2e.sh sets these per attested invoke; leave unset.
# ATTESTATION_HEX=0x
# BODY_HEX=0x
