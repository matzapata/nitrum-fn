# Copy to `tests/e2e/.env` (gitignored). Used by cloud.sh.

# Optional CLI override. Default is quiet `cargo run -q --bin nitrum-fn`.
# export NITRUM_FN_BIN="cargo run -q --manifest-path /absolute/path/to/nitrum-fn/Cargo.toml --bin nitrum-fn"

# Optional: skip terraform lookup. After `terraform apply` recreates the ALB/NLB,
# unset these (or update them) — destroyed LB hostnames NXDOMAIN.
# export NITRUM_FN_API_URL=http://nitrum-fn-api-xxxx.us-east-1.elb.amazonaws.com
# export NITRUM_FN_INVOKE_URL=https://nitrum-fn-nlb-xxxx.elb.us-east-1.amazonaws.com
# export NITRUM_FN_PCR0=<pcr0 hex from nitrum build>

# export NITRUM_FN_E2E_TF_DIR=/absolute/path/to/nitrum-fn/infra/envs/staging
# export ENCLAVE_TLS_INSECURE=1
# export NITRUM_FN_E2E_API_TIMEOUT=90
# export NITRUM_FN_E2E_INVOKE_TIMEOUT=600
# export NITRUM_FN_E2E_POLL_SECONDS=5
