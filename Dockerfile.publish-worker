# syntax=docker/dockerfile:1.7
#
# Fargate publish worker (`nitrum-fn-publish-worker`). Must be musl so .cwasm matches the enclave.
# Build: docker build --platform linux/amd64 -f Dockerfile.publish-worker -t … .
FROM --platform=linux/amd64 rust:1.95-bookworm AS builder

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates

RUN --mount=type=cache,id=nitrum-fn-publish-worker-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=nitrum-fn-publish-worker-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=nitrum-fn-publish-worker-target,target=/build/target,sharing=locked \
    cargo build --locked --release --target x86_64-unknown-linux-musl -p publish-worker --bin nitrum-fn-publish-worker \
    && mkdir -p /out \
    && cp /build/target/x86_64-unknown-linux-musl/release/nitrum-fn-publish-worker /out/nitrum-fn-publish-worker

FROM --platform=linux/amd64 debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/nitrum-fn-publish-worker /usr/local/bin/nitrum-fn-publish-worker

USER 65534:65534

CMD ["nitrum-fn-publish-worker"]
