aws_region = "us-east-1"
# Must equal [project].name in nitrum.toml (SSM /nitrum/{name}/…). Staging vs prod
# is the AWS account, not a different slug.
project_name = "nitrum-fn"
retain       = false

# false = network + store + API + worker (no Nitro hosts). Flip to true after you have an EIF + PCR0.
enable_enclave = false

# Defaults are GHCR (CI publishes these). Override for Docker Hub or another registry:
# api_image    = "matzapata/nitrum-fn-api:latest"
# worker_image = "matzapata/nitrum-fn-publish-worker:latest"

# Optional later: NLB alias (requires hosted_zone_id). Default invoke URL is the NLB DNS name.
# hosted_zone_id   = "ZXXXXXXXXXXXX"
# invoke_hostname  = "fn.staging.example.com"

# Required when enable_enclave = true. Run `nitrum build` first; Terraform uploads the EIF.
# Bump both labels on every EIF rebuild.
# eif_version_label = "000000000000"
# eif_image_sha384  = "replace-with-pcr0-sha384-hex"

# Enclave sizing (matches the Nitrum template defaults).
asg_min_size                     = 1
asg_max_size                     = 2
asg_desired_capacity             = 1
enclave_cpu_count                = 2
enclave_memory_mib               = 4320
instance_type                    = "m6i.xlarge"
rolling_min_instances_in_service = 1
