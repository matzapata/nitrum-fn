# Copy to `.env` (gitignored). Foundry loads it for forge script / cast.

# --- shared ---
PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Deploy.s.sol ---
# MAX_AGE_SECONDS=3600
# CERT_OWNER=0x
# CERT_REVOKER=0x
# EXISTING_VALIDATOR=0x

# --- SetEnclave.s.sol ---
ORACLE_ADDRESS=0x
# 48-byte hex from `nitrum build` / eif.json (no 0x). Used if PCR0_HASH is unset.
PCR0=
# Optional: path to guest .wasm (default: ../enclave/target/wasm32-unknown-unknown/release/oracle.wasm)
# WASM_PATH=../enclave/target/wasm32-unknown-unknown/release/oracle.wasm
# Or pass hashes directly (0x-prefixed bytes32). CONTENT_HASH == x-nitrum-fn-hash.
# PCR0_HASH=0x
# CONTENT_HASH=0x

# --- UpdatePrices.s.sol (from staging invoke) ---
# ATTESTATION_HEX=0x
# BODY_HEX=0x
# CACHE_CERTS=true
