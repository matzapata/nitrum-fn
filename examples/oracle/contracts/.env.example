# Copy to `.env` (gitignored). Foundry loads it for forge script / cast;
# `set -a && source .env && set +a` loads it for the CLI (deploy / invoke) too.

# --- shared ---
PRIVATE_KEY=0x
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ALB — cargo run -p cli -- deploy
API_URL=
# NLB — cargo run -p cli -- invoke
INVOKE_URL=

# --- Deploy.s.sol ---
# MAX_AGE_SECONDS=3600
# CERT_OWNER=0x
# CERT_REVOKER=0x
# EXISTING_VALIDATOR=0x

# --- SetEnclave.s.sol ---
ORACLE_ADDRESS=0x
# 48-byte hex from `nitrum build` / eif.json (no 0x). Used if PCR0_HASH is unset.
PCR0=
# sha256 of oracle.wasm (0x-prefixed). From `nitrum-fn describe ./oracle.wasm` (`hash=`).
# Same value as invoke `--fn-shasum` / `x-nitrum-fn-shasum`.
CONTENT_HASH=0x
# PCR0_HASH=0x

# --- UpdatePrices.s.sol (from staging invoke) ---
# ATTESTATION_HEX=0x
# BODY_HEX=0x
